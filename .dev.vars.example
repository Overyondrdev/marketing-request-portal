# Copy to .dev.vars (git-ignored) for local development. NEVER set DEV_EMAIL in production.
# Signs you in as this person without Cloudflare Access; send an X-Dev-Email header to act as someone else.
DEV_EMAIL="your.name@overyondr.com"
# People who are always admins.
OWNER_EMAILS="your.name@overyondr.com"
# Optional: send real email locally through Resend (also set EMAIL_ENABLED="on"). Use a test key.
# RESEND_API_KEY="re_..."
# EMAIL_ENABLED="on"
# Optional: post new and overdue work to a Slack channel.
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
